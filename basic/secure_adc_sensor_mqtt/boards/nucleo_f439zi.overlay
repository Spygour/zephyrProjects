/ {
    leds {
        compatible = "gpio-leds";

        my_led: led_0 {
            gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
            label = "My led";
        };
    };

    pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "okay";

		led2_pwm: led2_pwm {
			pwms = <&pwm2 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

    aliases {
		  led4 = &my_led;
      pwm-led0 = &led2_pwm;
      timer0 = &counter1;
			adc0 = &adc3;
	  };

		zephyr,user {
			/* adjust channel number according to pinmux in board.dts */
			io-channels = <&adc3 14>;
		};
};

&timers2 {
	status = "okay";
  st,prescaler = <10000>;
	counter1: counter {
		compatible = "st,stm32-counter";
		status = "okay";
		label = "COUNTER_2";
	};
};

&timers3 {
	st,prescaler = <10000>;
	status = "okay";
	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch4_pc9>;
		pinctrl-names = "default";
	};
};

&adc3 {
    status = "okay";
    pinctrl-0 = <&adc3_in14_pf4>;
    pinctrl-names = "default";
		st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
		#address-cells = <1>;
		#size-cells = <0>;
    channel@e {
        reg = <14>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
    };
};